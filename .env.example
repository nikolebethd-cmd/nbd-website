# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Scripts:    node --env-file=.env <script>.js
# Dev server: reads .env automatically (see .claude/launch.json)

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe — from dashboard.stripe.com/apikeys ("Secret key", starts sk_)
STRIPE_SECRET_KEY=

# Set to "false" in production to require real payment before downloads.
# Anything else (or unset) leaves the paywall OFF.
DEV_MODE=
